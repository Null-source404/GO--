# Server Configuration
PORT=8080

# Optional: Firebase Authentication & Firestore Configuration
# Copy this file to .env (or provide via environment variables in production).
# Never commit real API keys or Firebase credentials to version control.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_FIRESTORE_DATABASE_ID=(default)
